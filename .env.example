# ── Mode ──────────────────────────────────────────────────────────────────────
# Set USE_SQLITE=true for local development (no MySQL needed).
# Set USE_SQLITE=false (or omit) for production MySQL.
USE_SQLITE=true
SQLITE_PATH=dev/conapesca_dev.sqlite

# ── MySQL (production) ────────────────────────────────────────────────────────
# Fill these when deploying against the real server.
# Alternatively, set DATABASE_URL=mysql://user:pass@host:3306/dbname
CONAPESCA_DB_HOST=CHANGEME
CONAPESCA_DB_PORT=3306
CONAPESCA_DB_USER=CHANGEME
CONAPESCA_DB_PASSWORD=CHANGEME
CONAPESCA_DB_NAME=CHANGEME

# DB timeouts in seconds. READ is how long ONE query may run before the connection
# is dropped (the first species_count query alone takes 60-80s on the full table);
# keep it under the caller's own timeout (the orchestrator uses 120s for this MCP).
# CONNECT stays low on purpose: an unreachable DB should fail fast.
DB_READ_TIMEOUT_SECONDS=110
DB_CONNECT_TIMEOUT_SECONDS=60

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
MCP_BASE_PATH=/mcp
LOG_LEVEL=INFO

# ── Cache ─────────────────────────────────────────────────────────────────────
# TTL (seconds) of the in-memory cache for near-static tools, and whether to
# pre-fill it in the background at startup and renew it at 80% of the TTL (so
# no client pays for the slow queries). A full pass takes a few minutes on the
# real table: keep CACHE_TTL_SECONDS well above that.
CACHE_TTL_SECONDS=3600
CACHE_WARMUP=true

# ── Docker ────────────────────────────────────────────────────────────────────
# Required when multiple MCP servers share the same parent directory name.
# Prevents Docker network conflicts between co-deployed services.
COMPOSE_PROJECT_NAME=conapesca-mcp
